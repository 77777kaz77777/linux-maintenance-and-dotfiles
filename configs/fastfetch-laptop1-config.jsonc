#MainLaptop fastfetch config

{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "display": {
    "separator": "  ",
    "color": {
      "keys": "32",
      "title": "1;32",
      "output": "97",
      "separator": "90"
    },
    "key": {
      "width": 12
    },
    "percent": {
      "type": [
        "num"
      ]
    },
    "bar": {
      "char": {
        "elapsed": "█",
        "total": "░"
      },
      "border": {
        "left": "",
        "right": ""
      },
      "color": {
        "elapsed": "32",
        "total": "90"
      },
      "width": 10
    }
  },
  "modules": [
    {
      "type": "title",
      "key": "User",
      "color": {
        "user": "32",
        "at": "90",
        "host": "97"
      }
    },
    {
      "type": "custom",
      "format": "── Distro Info ───────────────────────────────"
    },
    {
      "type": "os",
      "key": "OS",
      "format": "{2} {12}"
    },
    {
      "type": "kernel",
      "key": "Kernel",
      "format": "{2}"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "locale",
      "key": "Locale"
    },
    {
      "type": "custom",
      "format": "── Hardware ──────────────────────────────────"
    },
    {
      "type": "host",
      "key": "Host"
    },
    {
      "type": "display",
      "key": "Display"
    },
    {
      "type": "cpu",
      "key": "CPU",
      "format": "{1}"
    },
    {
      "type": "gpu",
      "key": "GPU",
      "format": "{2}"
    },
    {
      "type": "memory",
      "key": "Memory",
      "format": "{1} / {2} ({3})"
    },
    {
      "type": "swap",
      "key": "Swap"
    },
    {
      "type": "disk",
      "key": "Disk",
      "format": "{1} / {2} ({3})",
      "hideFolders": "/efi:/boot:/boot/*"
    },
    {
      "type": "battery",
      "key": "Battery",
      "format": "({1}) [{4}]"
    },
    {
      "type": "poweradapter",
      "key": "Power"
    },
    {
      "type": "custom",
      "format": "── Desktop Environment ───────────────────────"
    },
    {
      "type": "de",
      "key": "DE"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "wmtheme",
      "key": "WM Theme"
    },
    {
      "type": "theme",
      "key": "Theme"
    },
    {
      "type": "icons",
      "key": "Icons"
    },
    {
      "type": "font",
      "key": "Font"
    },
    {
      "type": "cursor",
      "key": "Cursor"
    },
    {
      "type": "custom",
      "format": "── Terminal & Shell ──────────────────────────"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "terminalfont",
      "key": "Term Font"
    },
    {
      "type": "break"
    },
    {
      "type": "colors",
      "key": "Palette",
      "symbol": "circle",
      "block": {
        "width": 3,
        "range": [
          1,
          7
        ]
      }
    }
  ]
}
